# Copie para .env e preencha. O .env NUNCA vai para o Git.
# Só nomes aqui. Nada com prefixo VITE_ é secreto; credencial de plataforma nunca vai para o front.

# Ambiente: development | production
APP_ENV=development
TZ=America/Sao_Paulo

# Front (apps/web). Sem os dois primeiros o app abre no modo demonstração.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SAMPLE_DATA=true

# Supabase do CSP-MKT (worker e Edge Functions)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# CSP 360 (CRM do grupo): credencial SÓ-LEITURA criada para o CSP-MKT, nunca a chave de serviço do CRM
CSP360_SUPABASE_URL=
CSP360_READONLY_KEY=

# Meta (Marketing API, Lead Ads, Instagram). Leitura e escrita separadas.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN_READ=
META_ACCESS_TOKEN_WRITE=

# TikTok Marketing API
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# GA4 Data API e Search Console API (conta de serviço como Leitor). Só no Railway, nunca no front.
# As propriedades não entram aqui: ficam em mkt.web_properties, cadastradas por scripts/cadastrar-ga4.mjs.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Worker (apps/worker): conexão do papel mkt_worker, cuja senha entra pelo job producao do CI. Só no Railway.
WORKER_DATABASE_URL=
# Só no .env local de quem configura (scripts de cadastro) e no segredo do job manual.
MKT_SETUP_DATABASE_URL=
GSC_SITE_CS=
GSC_SITE_PL=

# IA (só no worker)
ANTHROPIC_API_KEY=

# n8n (gatilhos e avisos)
N8N_WEBHOOK_SECRET=
ALERT_WHATSAPP_GROUP_ID=
